sistema_tramite.sql
*.sql
# Las migraciones de estructura sí se versionan (no contienen datos)
!database/migraciones/*.sql

# Archivos de configuración con credenciales reales
config/config_email.php
config/gemini_config.php
model/model_conexion.php
config/database.php
config/firmaperu.php

# Datos de ejecución (límite de intentos, temporales)
storage/*
!storage/.htaccess

# Entorno
.env
# Documentos subidos por funcionarios y ciudadanos: llevan DNI y datos
# personales, no deben entrar al repositorio. (Los que ya estaban versionados
# siguen rastreados hasta que se decida quitarlos con git rm --cached.)
controller/tramite/documentos/*
!controller/tramite/documentos/.htaccess
controller/tramite_area/documentos/*
!controller/tramite_area/documentos/.htaccess
